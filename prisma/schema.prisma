// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  uid                          String         @id @default(cuid())
  id                           String         @unique @db.VarChar(100)
  slug                         String?        @unique @db.VarChar(160)
  title                        String         @default("") @db.VarChar(200)
  description                  String         @default("") @db.Text
  availability                 String         @default("") @db.VarChar(32)
  condition                    String         @default("") @db.VarChar(32)
  price                        String         @default("") @db.VarChar(64)
  price_uyu                    Int?
  link                         String         @default("") @db.Text
  image_link                   String         @default("") @db.Text
  brand                        String         @default("") @db.VarChar(100)
  team                         String         @default("") @db.VarChar(120)
  season                       String         @default("") @db.VarChar(40)
  player_number                String         @default("") @db.VarChar(100)
  category                     String         @default("") @db.VarChar(60)
  sport                        String         @default("futbol") @db.VarChar(60)
  kit_version                  String         @default("") @db.VarChar(60)
  delivery_mode                String         @default("") @db.VarChar(60)
  active                       Boolean        @default(true)
  source_ref                   String         @default("") @db.Text
  google_product_category      String         @default("") @db.VarChar(255)
  fb_product_category          String         @default("") @db.VarChar(255)
  quantity_to_sell_on_facebook String         @default("") @db.VarChar(32)
  sale_price                   String         @default("") @db.VarChar(64)
  sale_price_effective_date    String         @default("") @db.VarChar(120)
  item_group_id                String         @default("") @db.VarChar(100)
  gender                       String         @default("") @db.VarChar(32)
  color                        String         @default("") @db.VarChar(200)
  size                         String         @default("") @db.VarChar(200)
  age_group                    String         @default("") @db.VarChar(32)
  material                     String         @default("") @db.VarChar(200)
  pattern                      String         @default("") @db.VarChar(100)
  shipping                     String         @default("") @db.Text
  shipping_weight              String         @default("") @db.VarChar(64)
  offer_disclaimer             String         @default("") @db.Text
  offer_disclaimer_url         String         @default("") @db.Text
  video_url                    String         @default("") @db.Text
  video_tag                    String         @default("") @db.VarChar(200)
  gtin                         String         @default("") @db.VarChar(64)
  product_tags                 String[]       @default([])
  style                        String         @default("") @db.VarChar(120)
  images                       ProductImage[]
  createdAt                    DateTime       @default(now())
  updatedAt                    DateTime       @updatedAt

  @@index([active, updatedAt(sort: Desc)])
  @@index([brand, availability])
  @@index([category, active])
  @@index([team])
  @@index([item_group_id])
  @@index([price_uyu])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String   @db.Text
  fileName  String   @default("") @db.VarChar(255)
  mimeType  String   @default("") @db.VarChar(64)
  sizeBytes Int?
  data      Bytes?
  position  Int      @default(0)
  isCover   Boolean  @default(false)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [uid], onDelete: Cascade)

  @@unique([productId, url])
  @@index([productId, position])
  @@index([fileName])
  @@map("product_images")
}
